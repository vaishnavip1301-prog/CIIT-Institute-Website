 
 
    <div class="container">
        <div class="row">
            <div class="col-md-4"></div>
            <div class="col-md-8">
                <div class="card" style="background-color:white;height:auto">
                <div class="card-header">
                    <h5 style="text-align:center">Enquiry <span style="color:orange">Now</span></h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label style="font-size:12px;"> Name : </label>
                                <input type="text" class="form-control" placeholder="Name" id="candidate_name" name="candidate_name" style="font-size:12px;" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label style="font-size:12px;"> Contact : </label>
                                <input type="text" class="form-control" placeholder="Contact" id="contact_number" name="contact_number" style="font-size:12px;" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label style="font-size:12px;"> Email : </label>
                                <input type="text" class="form-control" placeholder="Email" id="email_address" name="email_address" style="font-size:12px;" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label style="font-size:12px;"> Training Type : </label>
                                <select class="form-control" id="training_type" name="training_type" style="text-align:left;font-size:12px;">
                                    <option selected disabled style="font-size:12px;">Training Type</option>
                                    <option value="Online Training" style="font-size:12px;">Online Training</option>
                                    <option value="Offline Training" style="font-size:12px;">Offline Training</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label style="font-size:12px;"> Description : </label>
                                <textarea class="form-control" id="description" name="description" style="font-size:12px;" placeholder="enter your enquiry here"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <input type="button" value="Submit" id="btnsubmit" onclick="SubmitEnquiry()" class="btn" style="background-color:orange;color:white;font-weight:bold" />
                </div>
            </div>
            </div>
        </div>
    </div>
    <script>
        const SubmitEnquiry=async()=>{
            var candidate_name=document.getElementById("candidate_name").value;
            var contact_number=document.getElementById("contact_number").value;
            var email_address=document.getElementById("email_address").value;
            var training_type=document.getElementById("training_type").value;
            var description=document.getElementById("description").value;
          var st={
                          "candidate_name":candidate_name,
                          "mobile_number":contact_number,
                          "email_address":email_address,
                          "training_type":training_type,
                          "description":description
                 };
              const response=await fetch("/Lead/AddLeadSource",{
                  method:"post",
                  body:JSON.stringify(st),
                  headers:{
                      "content-type":"application/json"
                  }
              });
            const msg=await response.text();
            alert(msg);
          }

          // const FetchLeads=async()=>{
          //       const response=await fetch("/Lead/GetLeads");
          //       const leads=await response.json();

          // }
    </script>
 