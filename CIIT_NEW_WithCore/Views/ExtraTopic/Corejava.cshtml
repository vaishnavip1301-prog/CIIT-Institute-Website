            @Html.Partial("~/Views/Shared/MoneyBackGuarantee.cshtml")
            @Html.Partial("~/Views/Shared/Companies.cshtml")


            @Html.Partial("~/Views/Shared/KEYFeatures.cshtml")

            <div class="container" style="padding-left:2%;max-width:100%">
                <div class="row">

                    <div class="col-md-12">

                        <div class="shadow-lg p-3 mb-5 bg-body rounded" style="padding-left:2%;margin-top:2% ;max-width:100%">


                            <h5 style="color:orange">Course Highlights</h5>
                            <div class="mb-3 mt-2" style="padding-left:2%">
                                A standard Core Java training focus on the foundationals of the Java SE (Standard Edition) platform, providing the essential skills needed to build standalone and general-purpose java applications.
                            </div>
                            <div class="mb-3 mt-2" style="padding-left:2%">

                                <ul>

                                    <li>

                                        <i class="bi-star-fill" style="color:orange"></i>
                                        <b>Foundations & Syntax</b>:
                                        <div class="mb-3" style="margin-left:2%">
                                            <ul>
                                                <li>
                                                    <b>Java Environment</b>
                                                    <p class="mb-3" style="margin-left:2%">
                                                         Installation and configuration of the JDK (Java Development Kit) and IDEs like Eclipse or IntelliJ IDEA.
                                                    </p>
                                                </li>
                                                <li>
                                                    <b>Core Syntax</b>
                                                    <p class="mb-3" style="margin-left:2%">
                                                        Deep dive into variables, primitive data types (int, float, boolean), and operators

                                                    </p>
                                                </li>
                                                <li>
                                                    <b>Control Flow</b>
                                                    <p class="mb-3" style="margin-left:2%">
                                                        Mastery of decision-making statements (if-else, switch) and iterative loops (for, while, do-while).
                                                    </p>
                                                </li>

                                            </ul>
                                        </div>

                                    </li>

                                    <li>

                                        <i class="bi-star-fill" style="color:orange"></i>
                                        <b>Object-Oriented Programming (OOP)</b>:
                                        <div class="mb-3" style="margin-left:2%">
                                            <ul>
                                                <li>
                                                    <b>Core Pillars</b>
                                                    <p class="mb-3" style="margin-left:2%">
                                                        Intensive training on the four main pillars: Encapsulation, Inheritance, Polymorphism, and Abstraction.
                                                    </p>
                                                </li>
                                                <li>
                                                    <b>Class Mechanics</b>
                                                    <p class="mb-3" style="margin-left:2%">
                                                        Understanding class blueprints, object instantiation, constructors, and the use of the this and super keywords.
                                                    </p>
                                                </li>
                                                <li>
                                                    <b>Interfaces & Abstract Classes</b>
                                                    <p class="mb-3" style="margin-left:2%">
                                                        Learning how to design modular systems using interfaces and handling multiple inheritance
                                                    </p>
                                                </li>

                                            </ul>
                                        </div>

                                    </li>
                                    <li>

                                        <i class="bi-star-fill" style="color:orange"></i>
                                        <b>Advanced Topics</b>:
                                        <div class="mb-3" style="margin-left:2%">
                                            <ul>
                                                <li>
                                                    <b>Java Collections Framework</b>
                                                    <p class="mb-3" style="margin-left:2%">
                                                        Efficiently managing groups of objects using ArrayList, HashMap, HashSet, and LinkedList.
                                                    </p>
                                                </li>
                                                <li>
                                                    <b>Exception Handling</b>
                                                    <p class="mb-3" style="margin-left:2%">
                                                        Robust error management using try-catch-finally blocks and creating custom exceptions to prevent program crashes.
                                                    </p>
                                                </li>
                                                <li>
                                                    <b>Multithreading</b>
                                                    <p class="mb-3" style="margin-left:2%">
                                                        Developing responsive applications by executing multiple tasks concurrently using the Thread class and Runnable interface.
                                                    </p>
                                                </li>
                                                <li>
                                                    <b>File I/O</b>
                                                    <p class="mb-3" style="margin-left:2%">
                                                        Reading from and writing to files using streams (FileInputStream, BufferedReader) and object serialization.
                                                    </p>
                                                </li>

                                            </ul>
                                        </div>

                                    </li>
                                 
                                </ul>
                            </div>
                        </div>



                        <div class="shadow-lg p-3 mb-5 bg-body rounded" style="padding-left:2%;margin-top:2% ;max-width:100%">

                            <h5 style="color:orange">
                                Who can do?
                            </h5>
                            <div class="mb-3" style="padding-left:2%">
                                Core Java is a foundation-level technology, meaning it is designed to be accessible to almost anyone interested in entering the software industry. It does not require a specific degree or an advanced technical background to begin
                            </div>
                            <div class="mb-3" style="padding-left:2%">
                                <ul>
                                    <li>
                                        <b>Students & Fresh Graduates</b> :
                                        <p class="mb-3" style="margin-left:2%">
                                            Essential for Undergraduate students (B.E., B.Tech, BCA, B.Sc), those preparing for campus placements and technical internships at top-tier tech companies.
                                        </p>
                                    </li>
                                    <li>
                                        <b>Career Switchers</b> :
                                        <p class="mb-3" style="margin-left:2%">
                                            Professionals from non-IT fields  who want to switch into a stable IT . Java is often chosen because it is structured and teaches a "programmer's mindset".
                                        </p>
                                    </li>
                                    <li>
                                        <b>Testing Professionals</b> :
                                        <p class="mb-3" style="margin-left:2%">
                                            Manual testers looking to switch into Automation Testing using popular Java-based tools like Selenium
                                        </p>
                                    </li>
                                    <li>
                                        <b>Android Developers</b> :
                                        <p class="mb-3" style="margin-left:2%">
                                            Individuals who eventually want to build Android applications, as Core Java is a primary language for the Android platform.
                                        </p>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @Html.Partial("~/Views/Shared/Feedbacks.cshtml")
        </div>
    </div>
</div>