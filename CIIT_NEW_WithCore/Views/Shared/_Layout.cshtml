    <script>
        $(document).ready(function () {
            $(window).scroll(function () {
                if ($(this).scrollTop() > 100) {
                    $('#scrollUpButton').fadeIn();
                } else {
                    $('#scrollUpButton').fadeOut();
                }
            });

            $('#scrollUpButton').click(function () {
                $('html, body').animate({ scrollTop: 0 }, 800);
                return false;
            });
        });
    </script>

