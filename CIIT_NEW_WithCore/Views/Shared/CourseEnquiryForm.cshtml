<div class="card" style="background-color:white;height:auto">
    <div class="card-header">
        <h5 style="text-align:center">Enquiry <span style="color:orange">Now</span></h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label style="font-size:12px;"> Name : </label>
                    <input type="text" class="form-control" placeholder="Name" style="font-size:12px;" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label style="font-size:12px;"> Contact : </label>
                    <input type="text" class="form-control" placeholder="Contact" style="font-size:12px;" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label style="font-size:12px;"> Email : </label>
                    <input type="text" class="form-control" placeholder="Email" style="font-size:12px;" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label style="font-size:12px;"> Training Type : </label>
                    <select class="form-control" style="text-align:left;font-size:12px;">
                        <option selected disabled style="font-size:12px;">Training Type</option>
                        <option value="Online Training" style="font-size:12px;">Online Training</option>
                        <option value="Offline Training" style="font-size:12px;">Offline Training</option>
                    </select>
                </div>
            </div>
            <div class="col-md-12">
                <div class="mb-3">
                    <label style="font-size:12px;"> Description : </label>
                    <textarea class="form-control" style="font-size:12px;" placeholder="enter your enquiry here"></textarea>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <input type="button" value="Submit" class="btn" style="background-color:orange;color:white;font-weight:bold" />
    </div>
</div>