<div class="card" style="background-color:white;height:auto">
    <div class="card-header">
        <h2 style="text-align:center">Enquiry <span style="color:orange">Now</span></h2>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label> Name : </label>
                    <input type="text" class="form-control" placeholder="Name" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label> Contact : </label>
                    <input type="text" class="form-control" placeholder="Contact" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label> Email : </label>
                    <input type="text" class="form-control" placeholder="Email" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label> Training Type : </label>
                    <select class="form-control" style="text-align:left">
                        <option selected disabled>Training Type</option>
                        <option value="Online Training">Online Training</option>
                        <option value="Offline Training">Offline Training</option>
                    </select>
                </div>
            </div>
            <div class="col-md-12">
                <div class="mb-3">
                    <label> Description : </label>
                    <textarea class="form-control" placeholder="enter your enquiry here"></textarea>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <input type="button" value="Submit" class="btn" style="background-color:orange;color:white;font-weight:bold" />
    </div>
</div>