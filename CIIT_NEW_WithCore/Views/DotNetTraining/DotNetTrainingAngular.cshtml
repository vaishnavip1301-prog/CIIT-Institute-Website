<style>
    /* Custom style */
    .accordion-button::after {
        background-image: url("data:image/svg+xml,%3csvg viewBox='0 0 16 16' fill='%23333' xmlns='http://www.w3.org/2000/svg'%3e%3cpath fill-rule='evenodd' d='M8 0a1 1 0 0 1 1 1v6h6a1 1 0 1 1 0 2H9v6a1 1 0 1 1-2 0V9H1a1 1 0 0 1 0-2h6V1a1 1 0 0 1 1-1z' clip-rule='evenodd'/%3e%3c/svg%3e");
        transform: scale(.7) !important;
    }

    .accordion-button:not(.collapsed)::after {
        background-image: url("data:image/svg+xml,%3csvg viewBox='0 0 16 16' fill='%23333' xmlns='http://www.w3.org/2000/svg'%3e%3cpath fill-rule='evenodd' d='M0 8a1 1 0 0 1 1-1h14a1 1 0 1 1 0 2H1a1 1 0 0 1-1-1z' clip-rule='evenodd'/%3e%3c/svg%3e");
    }
</style>
<style>
    .accordion-button {
        display: flex;
        align-items: center;
    }

        .accordion-button i {
            margin-right: 10px; /* Adjust spacing as needed */
            transition: transform 0.3s ease-in-out; /* Smooth transition for icon change */
        }

        /* Optional: Style for the plus/minus icons if not using Font Awesome */
        .accordion-button.collapsed i::before {
            content: "+";
        }

        .accordion-button:not(.collapsed) i::before {
            content: "-";
        }

</style>
<script>
        $(document).ready(function() {
      $('.accordion-button').on('click', function() {
        let icon = $(this).find('i');
        if ($(this).hasClass('collapsed')) {
          icon.removeClass('fa-minus').addClass('fa-plus');
        } else {
          icon.removeClass('fa-plus').addClass('fa-minus');
        }
      });

      // Set initial icon state for any initially open accordion items
      $('.accordion-collapse.show').each(function() {
        $(this).prev('.accordion-header').find('.accordion-button i').removeClass('fa-plus').addClass('fa-minus');
      });
    });
</script>
